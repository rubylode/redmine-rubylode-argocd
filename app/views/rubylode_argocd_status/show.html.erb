<% html_title @settings.block_title %>
<% content_for :header_tags, stylesheet_link_tag("rubylode_argocd", plugin: "redmine_rubylode_argocd") %>
<h2><%= @settings.block_title %></h2>
<% reports = @settings.instances.to_h { |instance| [instance, RubylodeArgocd::ApplicationStatus.report_for(instance, @settings)] } %>
<p class="rubylode-argocd-summary"><%= RubylodeArgocd::ApplicationStatus.summary_for(reports.values).text %></p>
<% reports.each do |instance, report| %>
  <div class="rubylode-argocd-instance">
    <h3 class="rubylode-argocd-instance-name"><%= instance.name %></h3>
    <% if report.unavailable? %>
      <p class="rubylode-argocd-unavailable"><%= l("rubylode_argocd.status.unavailable") %></p>
      <% if User.current.admin? %>
        <p class="rubylode-argocd-hint"><%= l("rubylode_argocd.hints.reason", reason: report.failure_reason) %></p>
      <% end %>
    <% else %>
    <% if User.current.admin? && report.unknown_apps.any? %>
      <p class="rubylode-argocd-note"><%= l("rubylode_argocd.unknown_apps", instance: instance.name, apps: report.unknown_apps.join(", ")) %></p>
    <% end %>
    <table class="list rubylode-argocd-table">
      <thead>
        <tr>
          <th><%= l("rubylode_argocd.columns.app") %></th>
          <th><%= l("rubylode_argocd.columns.project") %></th>
          <th><%= l("rubylode_argocd.columns.health") %></th>
          <th><%= l("rubylode_argocd.columns.sync") %></th>
          <th><%= l("rubylode_argocd.columns.last_sync") %></th>
          <th><%= l("rubylode_argocd.columns.revision") %></th>
        </tr>
      </thead>
      <tbody>
        <% report.rows.each do |row| %>
          <tr class="rubylode-argocd-row">
            <td class="rubylode-argocd-name"><%= link_to (row.label || row.name), "#{instance.address}/applications/#{ERB::Util.url_encode(row.namespace)}/#{ERB::Util.url_encode(row.name)}" %>
              <% if row.failing_resources.any? %>
                <ul class="rubylode-argocd-resources">
                  <% row.failing_resources.each do |resource| %>
                    <li class="rubylode-argocd-resource"><%= resource.message.to_s.empty? ? l("rubylode_argocd.failing_resource_without_message", kind: resource.kind, name: resource.name, health: resource.health) : l("rubylode_argocd.failing_resource", kind: resource.kind, name: resource.name, health: resource.health, message: resource.message) %></li>
                  <% end %>
                </ul>
              <% end %>
              <% if row.detail_skipped %>
                <p class="rubylode-argocd-note"><%= l("rubylode_argocd.detail_skipped") %></p>
              <% end %>
            </td>
            <td class="rubylode-argocd-project"><%= row.project %></td>
            <td class="rubylode-argocd-health"><%= row.health %></td>
            <td class="rubylode-argocd-sync"><%= row.sync %></td>
            <td class="rubylode-argocd-last-sync">
              <% if row.finished_at %>
                <span title="<%= format_time(row.finished_at) %>"><%= l("rubylode_argocd.time_ago", time: time_ago_in_words(row.finished_at)) %></span>
              <% end %>
            </td>
            <td class="rubylode-argocd-revision"><%= row.source_count ? l("rubylode_argocd.source_count", count: row.source_count) : row.revision %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% end %>
  </div>
<% end %>
